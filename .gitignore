# ──────────────────────────────────────────────────────────────
# Fokiz .gitignore
# Copyright (C) Alenia Studios — GNU GPL v3
# ──────────────────────────────────────────────────────────────

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
*.egg-info/
*.egg
dist/
build/
sdist/

# Virtual environments
.env
.venv/
venv/
env/

# Testing / linting caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
coverage.xml

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# ──────────────────────────────────────────────────────────────
# Fokiz-specific exclusions
# ──────────────────────────────────────────────────────────────

# Internal design specification (not for public distribution)
EspecificaciónCompletadeFokiz.*

# Runtime state (generated by the monitor)
src/.monitor_state

# User databases (created at runtime in ~/.local/share/fokiz/)
*.db
*.sqlite3
basura/
.git_corrupted/
